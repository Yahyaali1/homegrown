{
  "manifest_version": 3,
  "name": "Homegrown",
  "version": "0.6.0",
  "description": "Your own AI, grown on your machine: act on any text or image in place and run web missions. Local GPU, works offline.",
  "minimum_chrome_version": "124",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Homegrown",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabCapture",
    "tabGroups",
    "tabs",
    "unlimitedStorage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-start.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "page-task": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Run your first page task (Summarize this page) on the current tab"
    },
    "launcher": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open Homegrown on this page (ask about the page or run a page task)"
    },
    "live-captions": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Live captions & translation for audio in this tab"
    }
  },
  "options_page": "settings.html",
  "omnibox": {
    "keyword": "eg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/tokens.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_permissions": [
    "debugger"
  ]
}
